# Copy to .env.local for local work. On Vercel, add the same names under Project > Settings > Environment Variables.
# None of these are required to run the app: without Supabase, answers stay on the device.

# Supabase (server-side only; never prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard (/admin). Without ADMIN_PASSCODE the admin page stays switched off.
ADMIN_PASSCODE=choose-a-long-passphrase
# Optional: separate secret for signing the admin session cookie (defaults to ADMIN_PASSCODE)
ADMIN_SESSION_SECRET=

# Check It (v2.0). Needed for /api/check. Without a key, Check It shows "Something went wrong" and the rest of the app is unaffected.
# Add in Vercel for Production only, like the Supabase keys. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-key
# Optional. Defaults shown.
# CHECK_MODEL=claude-haiku-5-5
# CHECK_MAX_TOKENS=1024
# CHECK_DAILY_LIMIT=10
# CHECK_GLOBAL_LIMIT=300
