{
  "name": "is-it-ai",
  "version": "2.0.0",
  "private": true,
  "description": "Is It AI? A senior-friendly mobile web app that helps adults 60+ recognize and respond safely to AI-enabled scams. DTO 5839 Group 6.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run validate:content",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:content": "node scripts/validate-content.mjs && node scripts/validate-check.mjs",
    "test": "node --experimental-strip-types --no-warnings --import ./tests/register.mjs --test \"tests/*.test.mjs\"",
    "release": "node scripts/release.mjs",
    "ci": "npm run validate:content && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0"
  }
}
